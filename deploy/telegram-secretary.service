[Unit]
Description=Telegram business secretary
Documentation=https://github.com/jtprogru/telegram-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=telegram-secretary
Group=telegram-secretary
WorkingDirectory=/opt/telegram-mcp
EnvironmentFile=/etc/telegram-mcp/secretary.env
Environment=TELEGRAM_SECRETARY_STATE_DIR=/var/lib/telegram-mcp
ExecStart=/opt/telegram-mcp/.venv/bin/telegram-secretary
Restart=always
RestartSec=5
StateDirectory=telegram-mcp

# This process holds only the bot token — no MTProto session — but it is the one
# that listens to strangers, so it gets the tighter box of the two.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
