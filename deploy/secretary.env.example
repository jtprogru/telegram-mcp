# Copy to /etc/telegram-mcp/secretary.env, chmod 600, chown telegram-secretary.
# This file must NOT contain TELEGRAM_MCP_SESSION: the secretary has no business
# with the MTProto session, and keeping it out is most of the point.

TELEGRAM_MCP_BOT_TOKEN=
TELEGRAM_MCP_BUSINESS_CONNECTION=
ANTHROPIC_API_KEY=

# How the agent refers to you in its own instructions.
TELEGRAM_SECRETARY_OWNER=

# Model and how hard it thinks. Opus 5 at medium effort suits short chat replies;
# raise to high if the answers feel thin.
TELEGRAM_SECRETARY_MODEL=claude-opus-5
TELEGRAM_SECRETARY_EFFORT=medium

# Safety valves.
TELEGRAM_SECRETARY_MAX_REPLIES_PER_HOUR=20
TELEGRAM_SECRETARY_HISTORY=24

# Off by default. Turning this on lets the agent use rights that cannot be undone:
# transferring Stars and gifts, converting gifts, changing the @username, deleting
# other people's messages. Telegram must have granted them too.
# TELEGRAM_SECRETARY_IRREVERSIBLE=1

# TELEGRAM_MCP_AGENT_MARKER=🤖
